{
  "name": "@lyra/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../.. dev:game",
    "dev:frontend": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "sync": "svelte-kit sync",
    "tauri": "tauri",
    "scenes:compile": "bun run --cwd ../.. scenes:compile",
    "scenes:watch": "bun run --cwd ../.. scenes:watch",
    "dev:tauri": "bun run scenes:compile && tauri dev -c src-tauri/tauri.dev.conf.json",
    "prepare:build": "bun run scenes:compile && bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run test:e2e:all",
    "test:e2e:all": "node scripts/build-e2e.mjs && bun run test:e2e:all:run",
    "test:e2e:all:run": "node scripts/run-save-e2e.mjs --full",
    "test:e2e:smoke": "node scripts/build-e2e.mjs && bun run test:e2e:smoke:run",
    "test:e2e:smoke:run": "node scripts/run-save-e2e.mjs --suite smoke",
    "test:e2e:gameplay": "node scripts/build-e2e.mjs && bun run test:e2e:gameplay:run",
    "test:e2e:gameplay:run": "node scripts/run-save-e2e.mjs --suite gameplay",
    "test:e2e:capture-proof": "node scripts/build-e2e.mjs && bun run test:e2e:capture-proof:run",
    "test:e2e:capture-proof:run": "node scripts/run-save-e2e.mjs --suite capture-proof",
    "test:e2e:save": "node scripts/build-e2e.mjs && bun run test:e2e:save:run",
    "test:e2e:save:run": "node scripts/run-save-e2e.mjs --suite capture-proof --suite save-core --suite save-management --suite exit-lifecycle",
    "test:e2e:save-core:run": "node scripts/run-save-e2e.mjs --suite save-core",
    "test:e2e:save-management:run": "node scripts/run-save-e2e.mjs --suite save-management",
    "test:e2e:exit-lifecycle:run": "node scripts/run-save-e2e.mjs --suite exit-lifecycle",
    "test:e2e:run": "bun run test:e2e:smoke:run",
    "test:e2e:ci-contracts": "node --test scripts/select-e2e-suites.test.mjs scripts/plan-e2e-ci.test.mjs scripts/e2e-ci-workflow.test.mjs",
    "check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "rust:fmt:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-tc": "5.3.0",
    "@lyra/asset-paths": "workspace:*",
    "@lyra/shared": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "expect-webdriverio": "^5.6.5",
    "tsx": "^4.23.0",
    "webdriverio": "^9.29.1"
  }
}
