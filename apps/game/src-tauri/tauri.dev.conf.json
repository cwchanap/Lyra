{
  "identifier": "com.chanwaichan.lyra.dev",
  "build": {
    "beforeDevCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "mcp-debug",
          "description": "Debug-only MCP bridge capability (debug_assertions, non-e2e)",
          "windows": ["main"],
          "permissions": ["mcp-bridge:default"]
        }
      ]
    }
  }
}
