{
  "identifier": "com.chanwaichan.lyra.e2e",
  "productName": "lyra-e2e",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "lyra-e2e",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio-e2e",
          "description": "E2E-only WebDriver capability (feature e2e)",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  }
}
